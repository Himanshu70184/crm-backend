PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d
# Comma-separated list of allowed browser origins (no trailing slash).
# This is the ONLY source for CORS — no hardcoded origins exist in code.
# Production example: CORS_ORIGIN=https://your-app.vercel.app
# Staging example:    CORS_ORIGIN=https://staging-app.vercel.app,http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=CRM <your@gmail.com>
